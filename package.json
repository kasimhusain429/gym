{
  "name": "ultrafit-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "reel:wide": "remotion render remotion/index.ts LoadReelWide public/video/load-reel-wide.mp4 --codec=h264 --crf=26",
    "reel:tall": "remotion render remotion/index.ts LoadReelTall public/video/load-reel-tall.mp4 --codec=h264 --crf=26",
    "reel": "npm run reel:wide && npm run reel:tall"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.28",
