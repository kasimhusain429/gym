    "motion": "^14.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.547",
    "@remotion/transitions": "^4.0.547",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.75.0",
    "remotion": "^4.0.547",
